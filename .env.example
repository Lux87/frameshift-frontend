# FrameShift Frontend — all vars below are optional.
# The frontend can be deployed with no env vars at all and configured at
# runtime via the Settings panel in the UI. Anything you do set here is
# used as an initial seed and can be overridden from the UI.
#
# Settings entered via the UI are persisted to data/config.json and survive
# restarts (except on Cloud Run, where the container filesystem is ephemeral
# and config is lost on cold start — see IMPLEMENTATION-GUIDE.md).

# FrameShift Engine URL (the IAP-protected domain)
# ENGINE_URL=https://frameshift-engine.com

# FrameShift API key (generated from the engine dashboard, starts with fsk_)
# FRAMESHIFT_API_KEY=fsk_your_key_here

# GCP service account key file (for IAP authentication)
# GOOGLE_SA_KEY_PATH=./sa-key.json

# IAP OAuth Client ID (the one created for IAP on the backend service)
# IAP_CLIENT_ID=123456-abc.apps.googleusercontent.com

# Local server port
PORT=8080
